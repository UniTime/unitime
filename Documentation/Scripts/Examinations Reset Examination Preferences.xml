 <script name="Examinations: Reset Examination Preferences" permission="Examination Periods" engine="ECMAScript" created="Tue Oct 27 04:17:08 EDT 2026">
  <description><![CDATA[Reset examination preferences.]]></description>
  <parameter name="type" label="Examination type" type="reference(ExamType)" default="final"/>
  <parameter name="override" label="Override existing preferences" type="boolean" default="false"/>
  <body><![CDATA[var examType = org.unitime.timetable.model.ExamType.findByReference(type);
var exams = org.unitime.timetable.model.Exam.findAll(new java.lang.Long(session.getUniqueId()), examType);

log.setStatus('Updading ' + exams.size() + ' exams ...', exams.size());

for (var i = 0; i < exams.size(); i++) {
  var exam = exams.get(i);
  log.info('Updating ' + exam.getLabel());
  log.incProgress();
  exam.generateDefaultPreferences(override);
  hibSession.saveOrUpdate(exam);
}]]></body>
</script>
